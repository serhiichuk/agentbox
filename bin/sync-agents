#!/usr/bin/env bash

# Apply agents/models.json, the role files in agents/*.md, and the optional
# global/AGENTS.md to every installed harness. Bash 3.2-compatible.

set -u -o pipefail

APPLY=0
changes=0
errors=0
backed_up=0
roles=' '
TMP_DIR=

usage() {
  cat <<'EOF'
Usage: sync-agents [--apply]
       sync-agents --resolve <claude|omp|agy> <role>

Reconcile agents/models.json, the role files in agents/*.md, and the optional
global/AGENTS.md with each installed harness. The default is a dry run that prints every change.
--resolve prints the model ID a harness runs for a role and changes nothing.

  omp     modelRoles and task.agentModelOverrides through `omp config set`,
          after a backup of config.yml; rendered role files linked into ~/.omp/agent/agents/
  claude  rendered role files linked into ~/.claude/agents/
  agy     rendered role files linked into ~/.gemini/config/agents/<name>/agent.md
  global  global/AGENTS.md, when present, linked to ~/.claude/CLAUDE.md,
          ~/.omp/agent/AGENTS.md, and ~/.gemini/config/AGENTS.md

A role's name is its file name. Its class is a `model: "@<class>"` frontmatter
line, else its entry in the roles map of models.json, else default. Upstream
role files stay unedited this way.

Only symlinks that point into this repo are replaced or removed.
EOF
}

init_paths() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
  REPO_ROOT=${SYNC_AGENTS_REPO_ROOT:-$(cd "$script_dir/.." && pwd)}
  AGENTS_DIR=$REPO_ROOT/agents
  MODELS=$AGENTS_DIR/models.json
  BUILD_DIR=$AGENTS_DIR/.build
  GLOBAL=$REPO_ROOT/global/AGENTS.md
  GLOBAL_HOME=${SYNC_AGENTS_HOME:-$HOME}
  OMP=${SYNC_AGENTS_OMP:-omp}
  CLAUDE_AGENTS=${SYNC_AGENTS_CLAUDE_DIR:-$HOME/.claude/agents}
  OMP_AGENTS=${SYNC_AGENTS_OMP_DIR:-$HOME/.omp/agent/agents}
  AGY_AGENTS=${SYNC_AGENTS_AGY_DIR:-$HOME/.gemini/config/agents}
}

report() {
  printf '%-7s %-8s %s\n' "$1" "$2" "$3"
}

change() {
  changes=$((changes + 1))
  report "$@"
}

error() {
  errors=$((errors + 1))
  printf 'error: %s\n' "$1" >&2
}

has_omp() { command -v "$OMP" >/dev/null 2>&1; }
has_claude() { [ -d "$(dirname "$CLAUDE_AGENTS")" ]; }
has_agy() { [ -d "$(dirname "$AGY_AGENTS")" ]; }

is_managed() {
  case $1 in
    "$REPO_ROOT"/*) return 0 ;;
  esac
  return 1
}

frontmatter_value() {
  awk -v key="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, key ":") == 1 {
      value = substr($0, length(key) + 2)
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      gsub(/^"|"$/, "", value)
      print value
      exit
    }' "$1"
}

body() {
  awk 'n >= 2 { print; next } $0 == "---" { n++ }' "$1"
}

role_class() {
  local model
  model=$(frontmatter_value "$1" model)
  case $model in
    @*) printf '%s\n' "${model#@}" ;;
    *) jq -r --arg r "$(basename "$1" .md)" '.roles[$r] // "default"' "$MODELS" ;;
  esac
}

resolve_model() {
  jq -r --arg h "$1" --arg a "$2" --arg c "$3" \
    '.agents[$a][$h] // .classes[$c][$h] // "inherit"' "$MODELS"
}

agy_tier() {
  # ponytail: tier guessed from the model ID; give agy an explicit pro/flash value in models.json if a model name stops saying which it is
  case $1 in
    pro | flash | inherit) printf '%s\n' "$1" ;;
    *pro*) printf 'pro\n' ;;
    *flash*) printf 'flash\n' ;;
    *) printf 'inherit\n' ;;
  esac
}

ensure_link() {
  local harness=$1 dest=$2 target=$3 current
  if [ -L "$dest" ]; then
    current=$(readlink "$dest")
    [ "$current" = "$target" ] && return
    if ! is_managed "$current"; then
      report "$harness" skip "$dest (foreign symlink)"
      return
    fi
    change "$harness" relink "$dest"
    [ "$APPLY" -eq 1 ] && ln -sfn "$target" "$dest"
  elif [ -e "$dest" ]; then
    report "$harness" skip "$dest (not a symlink)"
  else
    change "$harness" link "$dest"
    [ "$APPLY" -eq 1 ] && mkdir -p "$(dirname "$dest")" && ln -s "$target" "$dest"
  fi
}

write_rendered() {
  local harness=$1 rendered=$2 build=$3
  if [ -f "$build" ] && cmp -s "$rendered" "$build"; then
    return
  fi
  change "$harness" render "$build"
  [ "$APPLY" -eq 1 ] && mkdir -p "$(dirname "$build")" && cp "$rendered" "$build"
}

sync_role() {
  local file=$1 name=$2 class=$3 description model rendered build
  description=$(frontmatter_value "$file" description)

  if has_omp; then
    rendered=$TMP_DIR/omp-$name.md
    build=$BUILD_DIR/omp/$name.md
    {
      printf -- '---\nname: %s\ndescription: %s\n---\n' "$name" "$description"
      body "$file"
    } >"$rendered"
    write_rendered omp "$rendered" "$build"
    ensure_link omp "$OMP_AGENTS/$name.md" "$build"
  fi

  if has_claude; then
    model=$(resolve_model claude "$name" "$class")
    rendered=$TMP_DIR/claude-$name.md
    build=$BUILD_DIR/claude/$name.md
    {
      printf -- '---\nname: %s\ndescription: %s\nmodel: %s\n---\n' "$name" "$description" "$model"
      body "$file"
    } >"$rendered"
    write_rendered claude "$rendered" "$build"
    ensure_link claude "$CLAUDE_AGENTS/$name.md" "$build"
  fi

  if has_agy; then
    model=$(agy_tier "$(resolve_model agy "$name" "$class")")
    rendered=$TMP_DIR/agy-$name.md
    build=$BUILD_DIR/agy/$name/agent.md
    {
      printf -- '---\nname: %s\ndescription: %s\nmodel: %s\n---\n\n# Agent System Instructions\n' \
        "$name" "$description" "$model"
      body "$file"
    } >"$rendered"
    write_rendered agy "$rendered" "$build"
    ensure_link agy "$AGY_AGENTS/$name/agent.md" "$build"
  fi
}

remove_stale_link() {
  local harness=$1 link=$2 name=$3
  [ -L "$link" ] && is_managed "$(readlink "$link")" || return
  case $roles in
    *" $name "*) return ;;
  esac
  change "$harness" remove "$link"
  [ "$APPLY" -eq 1 ] || return 0
  rm "$link"
  [ "$harness" = agy ] && rmdir "$(dirname "$link")" 2>/dev/null
  return 0
}

remove_stale() {
  local link
  if has_omp; then
    for link in "$OMP_AGENTS"/*.md; do
      remove_stale_link omp "$link" "$(basename "$link" .md)"
    done
  fi
  if has_claude; then
    for link in "$CLAUDE_AGENTS"/*.md; do
      remove_stale_link claude "$link" "$(basename "$link" .md)"
    done
  fi
  if has_agy; then
    for link in "$AGY_AGENTS"/*/agent.md; do
      remove_stale_link agy "$link" "$(basename "$(dirname "$link")")"
    done
  fi
  return 0
}

backup_omp_config() {
  local dir
  [ "$backed_up" -eq 1 ] && return 0
  dir=$("$OMP" config path) || return 1
  cp -p "$dir/config.yml" "$dir/config.yml.sync-agents.$(date +%Y%m%d%H%M%S).bak" || return 1
  report omp backup "$dir/config.yml"
  backed_up=1
}

sync_omp_key() {
  local key=$1 section=$2 want have
  want=$(jq -cS --arg s "$section" '.[$s] // {} | with_entries(select(.value.omp) | .value = .value.omp)' "$MODELS")
  if ! have=$("$OMP" config get "$key" --json | jq -cS '.value // {}'); then
    error "cannot read omp setting $key"
    return
  fi
  [ "$want" = "$have" ] && return
  change omp set "$key"
  jq -rn --argjson old "$have" --argjson new "$want" \
    '(($old + $new) | keys[]) as $k | select($old[$k] != $new[$k])
     | "                 \($k): \($old[$k] // "-") -> \($new[$k] // "-")"'
  [ "$APPLY" -eq 1 ] || return
  if ! backup_omp_config; then
    error "cannot back up omp config.yml; $key left unchanged"
    return
  fi
  "$OMP" config set "$key" "$want" >/dev/null || error "omp config set $key failed"
}

sync_global() {
  local dest
  [ -f "$GLOBAL" ] || return 0
  for dest in "$GLOBAL_HOME/.claude/CLAUDE.md" "$GLOBAL_HOME/.omp/agent/AGENTS.md" \
    "$GLOBAL_HOME/.gemini/config/AGENTS.md"; do
    [ -d "$(dirname "$dest")" ] || continue
    ensure_link global "$dest" "$GLOBAL"
  done
}

resolve_role() {
  local harness=$1 role=$2 file model
  file=$AGENTS_DIR/$role.md
  [ -f "$file" ] || { error "no role file $file"; return 1; }
  model=$(jq -r --arg h "$harness" --arg a "$role" --arg c "$(role_class "$file")" \
    '.agents[$a][$h] // .classes[$c][$h] // empty' "$MODELS")
  [ -n "$model" ] || { error "models.json has no $harness model for $role"; return 1; }
  printf '%s\n' "$model"
}

main() {
  local file name class
  case ${1:-} in
    '') ;;
    --apply) APPLY=1 ;;
    --resolve)
      [ $# -eq 3 ] || { usage >&2; return 2; }
      init_paths
      resolve_role "$2" "$3"
      return
      ;;
    -h | --help)
      usage
      return 0
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac

  init_paths
  command -v jq >/dev/null 2>&1 || { error "jq is required"; return 1; }
  jq empty "$MODELS" 2>/dev/null || { error "invalid or missing $MODELS"; return 1; }
  TMP_DIR=$(mktemp -d) || return 1
  trap 'rm -rf "$TMP_DIR"' EXIT

  for file in "$AGENTS_DIR"/*.md; do
    [ -f "$file" ] || continue
    name=$(basename "$file" .md)
    class=$(role_class "$file")
    if ! jq -e --arg c "$class" '.classes[$c]' "$MODELS" >/dev/null; then
      error "$file: class '$class' is not in models.json"
    else
      roles="$roles$name "
      sync_role "$file" "$name" "$class"
    fi
  done

  remove_stale
  sync_global
  if has_omp; then
    sync_omp_key modelRoles classes
    sync_omp_key task.agentModelOverrides agents
  fi

  if [ "$APPLY" -eq 1 ]; then
    printf 'applied %d change(s)\n' "$changes"
  else
    printf 'dry run: %d change(s); rerun with --apply\n' "$changes"
  fi
  [ "$errors" -eq 0 ]
}

main "$@"
