#!/usr/bin/env bash

# Interactive manager for skill symlinks across known harness skill directories.
# Bash 3.2-compatible: macOS still ships an old bash.
#
# The render and refresh paths are deliberately fork-free. Every `tput`,
# `dirname`, `basename` or $(...) there costs a process, and with ~50 skills
# across ~7 harness directories that added up to ~100ms per frame and ~1.5s per
# toggle. Frames are now built as one string of inline escapes and written with
# a single printf, helpers return through globals instead of subshells, and the
# symlinks of all directories are read with one readlink. Past the forks, bash
# 3.2 spends microseconds per statement, so the hot paths avoid per-row work:
# rendered lines are cached, and the catalog part of each tab is copied in
# bulk. A full read-handle-draw cycle costs ~1-2ms, so keystrokes need no
# debouncing at all.

SOURCE_DIR=
AGENTS_SKILLS_DIR=
CLAUDE_SKILLS_DIR=
warning_text=
current_row=1
top_row=0
terminal_lines=24
terminal_cols=80
size_dirty=1
resize_pending=0
drawing=0
original_stty=
active_section=agents
source_real=
# Set for a folded group row. Each tab folds its own groups.
row_folded=()
fold_generation=0
OWN_GROUP=my-skills

row_kind=()
row_section=()
row_name=()
row_state=()
# Rows back to the row's group, 0 outside a group. The distance is the same in
# every tab, so the catalog block is copied without rebasing it.
row_up=()
# Children of a group row, which directly follow it; 0 for other rows.
row_child_count=()
source_names=()
source_origin=()
source_group=()
vendor_names=()
catalog_links=()
catalog_link_slots=()
# Entries of every harness directory in one flat list; tab idx owns the
# dest_count[idx] entries from dest_first[idx].
dest_names=()
dest_kinds=()
dest_targets=()
dest_first=()
dest_count=()
dest_links=()
dest_link_slots=()
block_kind=()
block_name=()
block_up=()
block_child_count=()
block_state=()
source_pos=()
visible_rows=()
visible_top=0
visible_key=
row_pos=()
rows_generation=0
section_ids=()
section_titles=()
section_dirs=()
section_first_row=()
section_row_count=()
realdir_keys=()
realdir_vals=()
row_lines=()

CSI=$'\e['
ANSI_REV=$'\e[7m'
ANSI_DIM=$'\e[2m'
ANSI_RESET=$'\e[0m'
ANSI_EL=$'\e[K'
ANSI_ED=$'\e[J'
FOOTER_TEXT='q: quit j/k ↑↓: move Space: toggle a: all n: none ←/→: fold Tab: harness'


init_paths() {
  local script_dir repo_root claude_config
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
  repo_root=$(cd "$script_dir/.." && pwd)

  SOURCE_DIR=${SYNC_SKILLS_SOURCE_DIR:-"$repo_root/skills"}
  AGENTS_SKILLS_DIR=${SYNC_SKILLS_AGENTS_SKILLS_DIR:-"$HOME/.agents/skills"}
  claude_config=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
  CLAUDE_SKILLS_DIR=${SYNC_SKILLS_CLAUDE_SKILLS_DIR:-"$claude_config/skills"}
}

add_section() {
  section_ids[${#section_ids[@]}]=$1
  section_titles[${#section_titles[@]}]=$2
  section_dirs[${#section_dirs[@]}]=$3
}


add_harness_section() {
  [[ -d "$3" || -d "$4" ]] || return 0
  add_section "$1" "$2" "$4"
}

init_sections() {
  local agents_config claude_config
  agents_config=${AGENTS_SKILLS_DIR%/*}
  claude_config=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
  section_ids=()
  section_titles=()
  section_dirs=()
  add_harness_section agents '.agents/skills' "$agents_config" "$AGENTS_SKILLS_DIR"
  add_harness_section claude '.claude/skills' "$claude_config" "$CLAUDE_SKILLS_DIR"
  add_harness_section gemini '.gemini/skills' "$HOME/.gemini" "$HOME/.gemini/skills"
  add_harness_section opencode '.opencode/skills' "$HOME/.opencode" "$HOME/.opencode/skills"
  add_harness_section pi '.pi/skills' "$HOME/.pi" "$HOME/.pi/skills"
  add_harness_section omp '.omp/skills' "$HOME/.omp" "$HOME/.omp/skills"
  add_harness_section codex '.codex/skills' "$HOME/.codex" "$HOME/.codex/skills"
  return 0
}

# Sections resolve by linear scan over a handful of ids; results come back in
# SECTION_IDX / SECTION_DIR / SECTION_TITLE so callers avoid a subshell.
_section_index() {
  local wanted=$1 i
  i=0
  while [[ $i -lt ${#section_ids[@]} ]]; do
    if [[ "${section_ids[$i]}" = "$wanted" ]]; then
      SECTION_IDX=$i
      return 0
    fi
    i=$((i + 1))
  done
  SECTION_IDX=-1
  return 1
}

_section_dir() {
  _section_index "$1" || return 1
  SECTION_DIR=${section_dirs[$SECTION_IDX]}
}

_section_title() {
  _section_index "$1" || return 1
  SECTION_TITLE=${section_titles[$SECTION_IDX]}
}

# Symlink-resolved directory paths, memoised per refresh: one `cd -P` per
# distinct parent instead of one per entry.
_realdir() {
  local wanted=$1 i resolved
  i=0
  while [[ $i -lt ${#realdir_keys[@]} ]]; do
    if [[ "${realdir_keys[$i]}" = "$wanted" ]]; then
      REALDIR=${realdir_vals[$i]}
      return 0
    fi
    i=$((i + 1))
  done
  if [[ -d "$wanted" ]]; then
    resolved=$(cd -P "$wanted" 2>/dev/null && pwd)
    [[ -n "$resolved" ]] || resolved=$wanted
  else
    resolved=$wanted
  fi
  realdir_keys[${#realdir_keys[@]}]=$wanted
  realdir_vals[${#realdir_vals[@]}]=$resolved
  REALDIR=$resolved
  return 0
}

reset_rows() {
  row_kind=()
  row_section=()
  row_name=()
  row_state=()
  row_up=()
  row_child_count=()
}

add_row() {
  row_kind[${#row_kind[@]}]=$1
  row_section[${#row_section[@]}]=$2
  row_name[${#row_name[@]}]=$3
  row_state[${#row_state[@]}]=$4
  row_up[${#row_up[@]}]=0
  row_child_count[${#row_child_count[@]}]=0
}

# Resolves every symlink in one readlink call; targets land in BATCH_TARGETS,
# index-aligned with the arguments.
_batch_readlink() {
  local out path IFS=$'\n'
  BATCH_TARGETS=()
  [[ $# -gt 0 ]] || return 0
  out=$(readlink -- "$@" 2>/dev/null) || out=
  # A split, not a ${out#*$'\n'} loop: bash 3.2 trims patterns in quadratic time.
  set -f
  BATCH_TARGETS=($out)
  set +f
  if [[ ${#BATCH_TARGETS[@]} -ne $# ]]; then
    # Batch output did not line up (e.g. a newline inside a target).
    BATCH_TARGETS=()
    for path in "$@"; do
      BATCH_TARGETS[${#BATCH_TARGETS[@]}]=$(readlink "$path" 2>/dev/null || printf '')
    done
  fi
  return 0
}

# Canonical form of the targets in BATCH_TARGETS from offset $1 on, index-aligned
# with the link paths that follow, in LINK_TARGETS. A relative target is read
# from its link's directory; the parent directory of a target is resolved and
# its last component is kept. Links in one directory mostly share a parent, so
# the previous parent is checked before the memo.
_canonical_targets() {
  local i=$1 path target parent last_parent= last_real=
  shift
  LINK_TARGETS=()
  for path in "$@"; do
    target=${BATCH_TARGETS[$i]:-}
    i=$((i + 1))
    if [[ -n "$target" ]]; then
      case "$target" in
        /*) ;;
        *) target=${path%/*}/$target ;;
      esac
      parent=${target%/*}
      [[ -n "$parent" ]] || parent=/
      if [[ "$parent" != "$last_parent" ]]; then
        _realdir "$parent"
        last_parent=$parent
        last_real=${REALDIR%/}
      fi
      target=$last_real/${target##*/}
    fi
    LINK_TARGETS[${#LINK_TARGETS[@]}]=$target
  done
  return 0
}

_link_targets() {
  _batch_readlink "$@"
  _canonical_targets 0 "$@"
}

# Glob output is already collation-sorted, so no sort(1) and no basename(1).
load_source_names() {
  local path
  source_names=()
  source_origin=()
  source_group=()
  vendor_names=()
  catalog_links=()
  catalog_link_slots=()
  [[ -d "$SOURCE_DIR" ]] || return 0
  for path in "$SOURCE_DIR"/*; do
    [[ -d "$path" ]] || continue
    if [[ -L "$path" ]]; then
      catalog_link_slots[${#catalog_link_slots[@]}]=${#source_names[@]}
      catalog_links[${#catalog_links[@]}]=$path
    fi
    source_names[${#source_names[@]}]=${path##*/}
    source_origin[${#source_origin[@]}]=
  done
  return 0
}

_scan_harness_dirs() {
  local idx dir path
  dest_names=()
  dest_kinds=()
  dest_targets=()
  dest_first=()
  dest_count=()
  dest_links=()
  dest_link_slots=()
  idx=0
  while [[ $idx -lt ${#section_dirs[@]} ]]; do
    dir=${section_dirs[$idx]}
    dest_first[$idx]=${#dest_names[@]}
    if [[ -d "$dir" ]]; then
      for path in "$dir"/*; do
        [[ -e "$path" || -L "$path" ]] || continue
        if [[ -L "$path" ]]; then
          dest_link_slots[${#dest_link_slots[@]}]=${#dest_names[@]}
          dest_links[${#dest_links[@]}]=$path
          dest_kinds[${#dest_kinds[@]}]=l
        else
          dest_kinds[${#dest_kinds[@]}]=e
        fi
        dest_names[${#dest_names[@]}]=${path##*/}
        dest_targets[${#dest_targets[@]}]=
      done
    fi
    dest_count[$idx]=$((${#dest_names[@]} - dest_first[idx]))
    idx=$((idx + 1))
  done
  return 0
}

# One readlink covers the catalog and every harness directory, because each
# fork costs about 2 ms. A vendored skill is a symlink into vendor/<repo>/, and
# that repo name is shown as a prefix in the list; skills owned by this repo
# have no prefix.
_read_links() {
  local i slot origin
  _batch_readlink ${catalog_links[@]+"${catalog_links[@]}"} ${dest_links[@]+"${dest_links[@]}"}
  i=0
  for slot in ${catalog_link_slots[@]+"${catalog_link_slots[@]}"}; do
    origin=${BATCH_TARGETS[$i]:-}
    case "$origin" in
      */vendor/*) origin=${origin#*/vendor/} ;;
      vendor/*) origin=${origin#vendor/} ;;
      *) origin= ;;
    esac
    source_origin[$slot]=${origin%%/*}
    i=$((i + 1))
  done
  _canonical_targets "$i" ${dest_links[@]+"${dest_links[@]}"}
  i=0
  for slot in ${dest_link_slots[@]+"${dest_link_slots[@]}"}; do
    dest_targets[$slot]=${LINK_TARGETS[$i]}
    i=$((i + 1))
  done
  return 0
}

# Insertion keeps vendor_names sorted; a handful of vendors does not justify
# forking sort(1).
_add_vendor() {
  local wanted=$1 i sorted placed
  for i in ${vendor_names[@]+"${vendor_names[@]}"}; do
    [[ "$i" = "$wanted" ]] && return 0
  done
  sorted=()
  placed=0
  for i in ${vendor_names[@]+"${vendor_names[@]}"}; do
    if [[ $placed -eq 0 && "$wanted" < "$i" ]]; then
      sorted[${#sorted[@]}]=$wanted
      placed=1
    fi
    sorted[${#sorted[@]}]=$i
  done
  [[ $placed -eq 1 ]] || sorted[${#sorted[@]}]=$wanted
  vendor_names=("${sorted[@]}")
}

# source_group: 0 for own skills, otherwise 1 + the vendor's index.
_group_sources() {
  local i g origin vendor
  for origin in ${source_origin[@]+"${source_origin[@]}"}; do
    [[ -n "$origin" ]] && _add_vendor "$origin"
  done
  i=0
  for origin in ${source_origin[@]+"${source_origin[@]}"}; do
    g=0
    if [[ -n "$origin" ]]; then
      for vendor in "${vendor_names[@]}"; do
        g=$((g + 1))
        [[ "$vendor" = "$origin" ]] && break
      done
    fi
    source_group[$i]=$g
    i=$((i + 1))
  done
  return 0
}

# kind: l (symlink), e (exists, not a link), empty (absent).
# target: canonical path the symlink resolves to, if any.
_compute_state() {
  local kind=$1 target=$2 has_source=$3 source_path=$source_real/$4
  case "$kind" in
    l)
      if [[ -z "$target" || ! -e "$target" ]]; then
        if [[ -n "$target" && "$target" = "$source_path" ]]; then
          STATE=stale
        else
          STATE=dangling
        fi
      elif [[ "$has_source" -eq 1 ]]; then
        if [[ "$target" = "$source_path" ]]; then
          STATE=enabled
        else
          STATE=foreign
        fi
      else
        STATE=readonly
      fi
      ;;
    e)
      STATE=readonly
      ;;
    *)
      if [[ "$has_source" -eq 1 ]]; then
        STATE=missing
      else
        STATE=readonly
      fi
      ;;
  esac
  return 0
}

_add_block_entry() {
  block_kind[${#block_kind[@]}]=$1
  block_name[${#block_name[@]}]=$2
  block_up[${#block_up[@]}]=$3
  block_child_count[${#block_child_count[@]}]=0
  block_state[${#block_state[@]}]=$4
}

# Every catalog skill is a row in every tab, in the same order, so the catalog
# part of a tab is laid out once per refresh, with all skills missing.
# source_pos maps a source index to its block offset.
# One group per origin: own skills, then each vendor.
build_catalog_block() {
  local i g name parent members
  block_kind=()
  block_name=()
  block_up=()
  block_child_count=()
  block_state=()
  source_pos=()
  members=()
  i=0
  while [[ $i -lt ${#source_names[@]} ]]; do
    g=${source_group[$i]}
    members[$g]="${members[$g]:-} $i"
    i=$((i + 1))
  done
  g=0
  while [[ $g -le ${#vendor_names[@]} ]]; do
    if [[ -n "${members[$g]:-}" ]]; then
      parent=${#block_kind[@]}
      if [[ $g -eq 0 ]]; then
        name=$OWN_GROUP
      else
        name=${vendor_names[$((g - 1))]}
      fi
      _add_block_entry group "$name" 0 ''
      for i in ${members[$g]}; do
        source_pos[$i]=${#block_kind[@]}
        _add_block_entry item "${source_names[$i]}" $((${#block_kind[@]} - parent)) missing
      done
      block_child_count[$parent]=$((${#block_kind[@]} - parent - 1))
    fi
    g=$((g + 1))
  done
  return 0
}

# Appends block entries [from, to) with this tab's states; reads the caller's
# tab_section and tab_state.
_append_block() {
  local from=$1 count=$(($2 - $1))
  [[ $count -gt 0 ]] || return 0
  row_kind+=("${block_kind[@]:$from:$count}")
  row_section+=("${tab_section[@]:$from:$count}")
  row_name+=("${block_name[@]:$from:$count}")
  row_state+=("${tab_state[@]:$from:$count}")
  row_up+=("${block_up[@]:$from:$count}")
  row_child_count+=("${block_child_count[@]:$from:$count}")
  return 0
}

# Rows of a section are contiguous, which keeps lookups and scrolling O(visible).
add_section_rows() {
  local idx=$1 section name first i j k pos src_count dest_end
  local tab_section tab_state extra_name extra_state

  section=${section_ids[$idx]}
  add_row header "$section" '' ''

  # Walk the two sorted name lists together. A name that is also a source
  # updates that skill's block state; any other name becomes an extra row.
  # Extra rows all go before the catalog.
  tab_state=(${block_state[@]+"${block_state[@]}"})
  extra_name=()
  extra_state=()
  src_count=${#source_names[@]}
  j=${dest_first[$idx]}
  dest_end=$((j + dest_count[idx]))
  i=0
  while [[ $j -lt $dest_end ]]; do
    name=${dest_names[$j]}
    while [[ $i -lt $src_count && "${source_names[$i]}" < "$name" ]]; do
      i=$((i + 1))
    done
    if [[ $i -lt $src_count && "${source_names[$i]}" = "$name" ]]; then
      _compute_state "${dest_kinds[$j]}" "${dest_targets[$j]}" 1 "$name"
      pos=${source_pos[$i]}
      tab_state[$pos]=$STATE
      i=$((i + 1))
    else
      _compute_state "${dest_kinds[$j]}" "${dest_targets[$j]}" 0 "$name"
      extra_name[${#extra_name[@]}]=$name
      extra_state[${#extra_state[@]}]=$STATE
    fi
    case "$STATE" in
      foreign|dangling) warning_text='Warning: unexpected state found; foreign or dangling symlinks are read-only.' ;;
    esac
    j=$((j + 1))
  done

  first=${#row_kind[@]}
  section_first_row[$idx]=$first
  tab_section=(${block_kind[@]+"${block_kind[@]/*/$section}"})
  k=0
  while [[ $k -lt ${#extra_name[@]} ]]; do
    add_row item "$section" "${extra_name[$k]}" "${extra_state[$k]}"
    k=$((k + 1))
  done
  _append_block 0 ${#block_kind[@]}

  section_row_count[$idx]=$((${#row_kind[@]} - first))
  return 0
}

refresh_state() {
  local old_section old_name old_kind idx
  old_section=
  old_name=
  old_kind=
  if [[ ${#row_kind[@]} -gt 0 && "${row_kind[$current_row]}" != header ]]; then
    old_section=${row_section[$current_row]}
    old_name=${row_name[$current_row]}
    old_kind=${row_kind[$current_row]}
  fi

  init_sections
  if ! _section_index "$active_section"; then
    if [[ ${#section_ids[@]} -gt 0 ]]; then
      active_section=${section_ids[0]}
    fi
  fi

  warning_text=
  realdir_keys=()
  realdir_vals=()
  row_lines=()
  section_first_row=()
  section_row_count=()
  reset_rows
  load_source_names
  _scan_harness_dirs
  _read_links
  _group_sources
  build_catalog_block
  _realdir "$SOURCE_DIR"
  source_real=$REALDIR

  idx=0
  while [[ $idx -lt ${#section_ids[@]} ]]; do
    add_section_rows "$idx"
    idx=$((idx + 1))
  done

  _fold_unselected_groups
  rows_generation=$((rows_generation + 1))
  size_dirty=1
  if [[ -n "$old_name" ]] && _find_row "$old_section" "$old_name" "$old_kind"; then
    current_row=$ROW_IDX
  else
    focus_first_item
  fi
  return 0
}

focus_first_item_in_section() {
  _section_index "$1" || return 1
  [[ "${section_row_count[$SECTION_IDX]:-0}" -gt 0 ]] || return 1
  current_row=${section_first_row[$SECTION_IDX]}
}

_find_row() {
  local section=$1 name=$2 kind=${3:-item} first count i row_name_i
  _section_index "$section" || return 1
  first=${section_first_row[$SECTION_IDX]:-}
  [[ -n "$first" ]] || return 1
  count=${section_row_count[$SECTION_IDX]:-0}
  [[ $count -gt 0 ]] || return 1
  i=$first
  for row_name_i in "${row_name[@]:$first:$count}"; do
    if [[ "$row_name_i" = "$name" && "${row_kind[$i]}" = "$kind" ]]; then
      ROW_IDX=$i
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

find_row() {
  _find_row "$1" "$2" || return 1
  printf '%s\n' "$ROW_IDX"
}

focus_item() {
  _find_row "$1" "$2" || return 1
  current_row=$ROW_IDX
}

focus_first_item() {
  local section
  focus_first_item_in_section "$active_section" && return 0
  for section in ${section_ids[@]+"${section_ids[@]}"}; do
    if focus_first_item_in_section "$section"; then
      active_section=$section
      return 0
    fi
  done
  current_row=0
  return 0
}

assert_row_state() {
  if ! _find_row "$1" "$2"; then
    printf 'row not found: %s/%s\n' "$1" "$2" >&2
    return 1
  fi
  if [[ "${row_state[$ROW_IDX]}" != "$3" ]]; then
    printf 'state mismatch for %s/%s: expected %s, got %s\n' "$1" "$2" "$3" "${row_state[$ROW_IDX]}" >&2
    return 1
  fi
}

_format_row_index() {
  local idx=$1 name
  if [[ "${row_kind[$idx]}" = header ]]; then
    _section_title "${row_section[$idx]}" || SECTION_TITLE=${row_section[$idx]}
    ROW_LABEL="── $SECTION_TITLE ──────────────────"
    return 0
  fi
  if [[ "${row_kind[$idx]}" = group ]]; then
    _group_mark "$idx"
    ROW_LABEL="$GROUP_MARK ${row_name[$idx]}"
    return 0
  fi

  name=${row_name[$idx]}
  case "${row_state[$idx]}" in
    enabled) ROW_LABEL="[x] $name" ;;
    readonly) ROW_LABEL="[x] $name (read-only)" ;;
    missing) ROW_LABEL="[ ] $name" ;;
    stale) ROW_LABEL="[!] $name (stale)" ;;
    foreign|dangling) ROW_LABEL="[!] $name (read-only)" ;;
    *) ROW_LABEL="[] $name" ;;
  esac
  return 0
}

# Read-only children count as checked: they are present and cannot be removed.
_group_mark() {
  local group=$1 i end checked=0 unchecked=0
  i=$((group + 1))
  end=$((i + row_child_count[group]))
  while [[ $i -lt $end ]]; do
    case "${row_state[$i]}" in
      enabled|readonly) checked=1 ;;
      missing) unchecked=1 ;;
    esac
    i=$((i + 1))
  done
  if [[ $unchecked -eq 0 ]]; then
    GROUP_MARK='[x]'
  elif [[ $checked -eq 0 ]]; then
    GROUP_MARK='[ ]'
  else
    GROUP_MARK='[-]'
  fi
  return 0
}

# A group starts folded unless at least one of its skills is checked.
_fold_unselected_groups() {
  local i=0 count=${#row_kind[@]}
  row_folded=()
  while [[ $i -lt $count ]]; do
    if [[ "${row_kind[$i]}" = group ]]; then
      _group_mark "$i"
      [[ "$GROUP_MARK" = '[ ]' ]] && row_folded[$i]=1
    fi
    i=$((i + 1))
  done
  return 0
}

format_row_index() {
  _format_row_index "$1"
  printf '%s\n' "$ROW_LABEL"
}

format_row() {
  _find_row "$1" "$2" || return 1
  _format_row_index "$ROW_IDX"
  printf '%s\n' "$ROW_LABEL"
}

# A row's state is part of its own line and of its group's mark.
_forget_row_lines() {
  local i
  for i in "$@"; do
    unset "row_lines[$i]"
    [[ ${row_up[$i]} -eq 0 ]] || unset "row_lines[$((i - row_up[i]))]"
  done
}

# One ln or one rm covers all rows, so a whole group costs the same few forks
# as a single skill. Rows that the action does not apply to are skipped.
set_rows() {
  local action=$1 section=$2 dir i j name target paths rows removed
  shift 2
  _section_dir "$section" || return 1
  dir=$SECTION_DIR
  paths=()
  rows=()
  for i in "$@"; do
    case "$action:${row_state[$i]}" in
      enable:missing) paths[${#paths[@]}]=$SOURCE_DIR/${row_name[$i]} ;;
      disable:enabled|disable:stale) paths[${#paths[@]}]=$dir/${row_name[$i]} ;;
      *) continue ;;
    esac
    rows[${#rows[@]}]=$i
  done
  [[ ${#rows[@]} -gt 0 ]] || return 0

  if [[ "$action" = enable ]]; then
    if [[ ! -d "$dir" ]]; then
      mkdir -p "$dir" || return 0
    fi
    if ! ln -s "${paths[@]}" "$dir/"; then
      refresh_state
      return 0
    fi
    for i in "${rows[@]}"; do
      row_state[$i]=enabled
    done
    _forget_row_lines "${rows[@]}"
    return 0
  fi

  # The links are read again right before removal: only a link that still
  # points into the catalog may be removed.
  _link_targets "${paths[@]}"
  paths=()
  removed=()
  j=0
  for i in "${rows[@]}"; do
    name=${row_name[$i]}
    target=${LINK_TARGETS[$j]}
    j=$((j + 1))
    [[ -n "$target" ]] || continue
    [[ "$target" = "$source_real/$name" ]] || continue
    paths[${#paths[@]}]=$dir/$name
    # A removed stale link has no catalog skill behind it, so nothing is left to toggle.
    if [[ "${row_state[$i]}" = enabled ]]; then
      row_state[$i]=missing
    else
      row_state[$i]=readonly
    fi
    removed[${#removed[@]}]=$i
  done
  [[ ${#paths[@]} -gt 0 ]] || return 0
  _forget_row_lines "${removed[@]}"
  rm -- "${paths[@]}" || refresh_state
  return 0
}

_group_children() {
  local i=$(($1 + 1)) end
  end=$((i + row_child_count[$1]))
  CHILDREN=()
  while [[ $i -lt $end ]]; do
    CHILDREN[${#CHILDREN[@]}]=$i
    i=$((i + 1))
  done
  return 0
}

# A group with any unchecked skill gets all of them enabled; a fully checked
# group gets all of them disabled.
toggle_current() {
  local section
  [[ ${#row_kind[@]} -gt 0 ]] || return 0
  section=${row_section[$current_row]}
  case "${row_kind[$current_row]}" in
    item)
      case "${row_state[$current_row]}" in
        enabled|stale) set_rows disable "$section" "$current_row" ;;
        *) set_rows enable "$section" "$current_row" ;;
      esac
      ;;
    group)
      _group_mark "$current_row"
      _group_children "$current_row"
      if [[ "$GROUP_MARK" = '[x]' ]]; then
        set_rows disable "$section" "${CHILDREN[@]}"
      else
        set_rows enable "$section" "${CHILDREN[@]}"
      fi
      ;;
  esac
  return 0
}

bulk_section() {
  local action=$1 section first last i rows
  [[ ${#row_kind[@]} -gt 0 ]] || return 0
  [[ "${row_kind[$current_row]}" != header ]] || return 0
  section=${row_section[$current_row]}
  _section_index "$section" || return 0
  first=${section_first_row[$SECTION_IDX]:-0}
  last=$((first + ${section_row_count[$SECTION_IDX]:-0}))
  rows=()
  i=$first
  while [[ $i -lt $last ]]; do
    [[ "${row_kind[$i]}" = item ]] && rows[${#rows[@]}]=$i
    i=$((i + 1))
  done
  [[ ${#rows[@]} -gt 0 ]] || return 0
  set_rows "$action" "$section" "${rows[@]}"
}

# Tabs wrap around at both ends.
switch_tab() {
  local step=$1 count name kind
  count=${#section_ids[@]}
  [[ "$count" -gt 1 ]] || return 0
  _section_index "$active_section" || SECTION_IDX=0
  name=
  kind=
  if [[ ${#row_kind[@]} -gt 0 && "${row_kind[$current_row]}" != header ]]; then
    name=${row_name[$current_row]}
    kind=${row_kind[$current_row]}
  fi
  active_section=${section_ids[$(((SECTION_IDX + step + count) % count))]}
  if [[ -n "$name" ]] && _find_row "$active_section" "$name" "$kind"; then
    current_row=$ROW_IDX
  else
    focus_first_item_in_section "$active_section" || true
  fi
  top_row=$current_row
  return 0
}

# Left on a skill inside a group moves to the group; left on a group folds it.
fold_current() {
  local action=$1
  [[ ${#row_kind[@]} -gt 0 ]] || return 0
  case "${row_kind[$current_row]}" in
    group)
      if [[ "$action" = close ]]; then
        row_folded[$current_row]=1
      else
        unset "row_folded[$current_row]"
      fi
      fold_generation=$((fold_generation + 1))
      ;;
    item)
      if [[ "$action" = close && ${row_up[$current_row]} -gt 0 ]]; then
        current_row=$((current_row - row_up[current_row]))
      fi
      ;;
  esac
  return 0
}

# visible_rows lists the active tab's rows that are not folded away, and
# row_pos maps a row back to its position there. The index is rebuilt only when
# the tab, the fold state, or the rows change, so a keystroke does not rescan
# the tab.
_index_visible() {
  local key="$rows_generation:$active_section:$fold_generation" first last i n
  [[ "$key" = "$visible_key" ]] && return 0
  visible_key=$key
  visible_rows=()
  row_pos=()
  _section_index "$active_section" || return 0
  first=${section_first_row[$SECTION_IDX]:-0}
  last=$((first + ${section_row_count[$SECTION_IDX]:-0}))
  n=0
  i=$first
  while [[ $i -lt $last ]]; do
    visible_rows[$n]=$i
    row_pos[$i]=$n
    n=$((n + 1))
    [[ -n "${row_folded[$i]:-}" ]] && i=$((i + row_child_count[i]))
    i=$((i + 1))
  done
  return 0
}

move_cursor() {
  local pos
  _index_visible
  pos=${row_pos[$current_row]:-}
  [[ -n "$pos" ]] || return 0
  pos=$((pos + $1))
  [[ $pos -ge 0 && $pos -lt ${#visible_rows[@]} ]] || return 0
  current_row=${visible_rows[$pos]}
}

read_terminal_size() {
  local size rows cols
  size=$(stty size 2>/dev/null || true)
  rows=${size%% *}
  cols=${size##* }
  case "$rows:$cols" in
    *[!0-9:]*|:*|*:|'')
      rows=
      cols=
      ;;
  esac
  if [[ -n "$rows" && -n "$cols" && "$rows" -gt 0 && "$cols" -gt 0 ]]; then
    terminal_lines=$rows
    terminal_cols=$cols
  else
    terminal_lines=$(tput lines 2>/dev/null || printf '24')
    terminal_cols=$(tput cols 2>/dev/null || printf '80')
  fi
  [[ -n "$terminal_lines" ]] || terminal_lines=24
  [[ -n "$terminal_cols" ]] || terminal_cols=80
  return 0
}

# Folded rows take no screen space, so scrolling works on positions in
# visible_rows. top_row stays a row index.
ensure_visible() {
  local footer_lines visible n cur top
  footer_lines=2
  [[ -n "$warning_text" ]] && footer_lines=3
  visible=$((terminal_lines - footer_lines))
  [[ $visible -lt 1 ]] && visible=1
  visible_top=0

  if [[ ${#row_kind[@]} -eq 0 ]]; then
    top_row=0
    return 0
  fi

  if [[ "${row_kind[$current_row]}" = header || "${row_section[$current_row]}" != "$active_section" ]]; then
    focus_first_item_in_section "$active_section" || return 0
  fi
  _index_visible
  n=${#visible_rows[@]}
  [[ $n -gt 0 ]] || return 0
  # A folded group hides the cursor row, so the cursor moves to the group.
  [[ -n "${row_pos[$current_row]:-}" ]] || current_row=$((current_row - row_up[current_row]))
  cur=${row_pos[$current_row]}
  top=${row_pos[$top_row]:-0}

  [[ $cur -lt $top ]] && top=$cur
  [[ $cur -ge $((top + visible)) ]] && top=$((cur - visible + 1))
  [[ $((n - top)) -lt $visible ]] && top=$((n - visible))
  [[ $top -lt 0 ]] && top=0

  visible_top=$top
  top_row=${visible_rows[$top]}
  return 0
}

_format_tabs() {
  local i part
  TABS_LINE=
  i=0
  while [[ $i -lt ${#section_ids[@]} ]]; do
    if [[ "${section_ids[$i]}" = "$active_section" ]]; then
      part="[${section_titles[$i]}]"
    else
      part=${section_titles[$i]}
    fi
    if [[ $i -gt 0 ]]; then
      TABS_LINE="$TABS_LINE  "
    fi
    TABS_LINE=$TABS_LINE$part
    i=$((i + 1))
  done
  return 0
}

format_tabs() {
  _format_tabs
  printf '%s\n' "$TABS_LINE"
}

# A keystroke usually moves only the cursor, so row lines are cached until
# their row changes. A group line is cached unfolded, and the fold mark is
# applied on each draw, so folding does not touch the cache.
_row_line() {
  local i=$1 label
  ROW_LINE=${row_lines[$i]:-}
  if [[ -z "$ROW_LINE" ]]; then
    _format_row_index "$i"
    label=$ROW_LABEL
    if [[ "${row_kind[$i]}" = group ]]; then
      label="- $label/"
    elif [[ ${row_up[$i]} -gt 0 ]]; then
      label="      $label"
    else
      label="    $label"
    fi
    [[ ${#label} -gt "$terminal_cols" ]] && label=${label:0:$terminal_cols}
    ROW_LINE=$label$ANSI_RESET$ANSI_EL
    case "${row_state[$i]}" in
      readonly|foreign|dangling) ROW_LINE=$ANSI_DIM$ROW_LINE ;;
    esac
    row_lines[$i]=$ROW_LINE
  fi
  [[ -n "${row_folded[$i]:-}" ]] && ROW_LINE="+${ROW_LINE#-}"
  return 0
}

# One frame, one write. Cursor moves and attributes are inline escapes; each
# line is cleared with EL instead of being padded, so nothing is truncated
# mid-character and the bottom-right cell is never touched.
draw() {
  local i line max_rows footer_row frame label
  drawing=1
  if [[ "$size_dirty" -eq 1 ]]; then
    read_terminal_size
    size_dirty=0
    row_lines=()
  fi
  ensure_visible

  _format_tabs
  label=$TABS_LINE
  [[ ${#label} -gt "$terminal_cols" ]] && label=${label:0:$terminal_cols}
  frame=$CSI'1;1H'$label$ANSI_EL

  max_rows=$terminal_lines
  [[ -n "$warning_text" ]] && max_rows=$((max_rows - 1))
  max_rows=$((max_rows - 2))
  [[ $max_rows -lt 1 ]] && max_rows=1

  line=1
  for i in ${visible_rows[@]+"${visible_rows[@]:$visible_top:$max_rows}"}; do
    ROW_LINE=${row_lines[$i]:-}
    if [[ -z "$ROW_LINE" || "${row_kind[$i]}" = group ]]; then
      _row_line "$i"
    fi
    frame=$frame$CSI$((line + 1))';1H'
    [[ "$i" -eq "$current_row" ]] && frame=$frame$ANSI_REV
    frame=$frame$ROW_LINE
    line=$((line + 1))
  done

  if [[ -n "$warning_text" && $line -lt $terminal_lines ]]; then
    label=$warning_text
    [[ ${#label} -gt "$terminal_cols" ]] && label=${label:0:$terminal_cols}
    frame=$frame$CSI$((line + 1))';1H'$label$ANSI_EL
    line=$((line + 1))
  fi

  footer_row=$((terminal_lines - 1))
  [[ $footer_row -lt 0 ]] && footer_row=0
  if [[ $line -lt $footer_row ]]; then
    frame=$frame$CSI$((line + 1))';1H'$ANSI_ED
  fi

  label=$FOOTER_TEXT
  [[ ${#label} -gt "$terminal_cols" ]] && label=${label:0:$terminal_cols}
  frame=$frame$CSI$((footer_row + 1))';1H'$label$ANSI_EL

  printf '%s' "$frame"
  drawing=0
  return 0
}

cleanup_terminal() {
  trap - INT TERM EXIT
  if [[ -n "$original_stty" ]]; then
    stty "$original_stty" 2>/dev/null || true
  fi
  tput cnorm 2>/dev/null || true
  tput sgr0 2>/dev/null || true
  tput rmcup 2>/dev/null || true
}

interrupt_exit() {
  cleanup_terminal
  exit 130
}

term_exit() {
  cleanup_terminal
  exit 143
}

# bash runs this trap while blocked in read and then resumes the read, so the
# redraw has to happen here: the main loop would not get control until the next
# keystroke. `drawing` avoids interleaving with a draw that is already running.
handle_resize() {
  resize_pending=1
  size_dirty=1
  [[ "$drawing" -eq 1 ]] && return 0
  resize_pending=0
  draw
  return 0
}

setup_terminal() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'sync-skills requires an interactive terminal.\n' >&2
    exit 1
  fi
  original_stty=$(stty -g)
  trap cleanup_terminal EXIT
  trap interrupt_exit INT
  trap term_exit TERM
  trap handle_resize WINCH
  tput smcup 2>/dev/null || true
  tput civis 2>/dev/null || true
  stty -echo -icanon min 1 time 0
}

handle_key() {
  local key=$1 rest=
  case "$key" in
    q) return 1 ;;
    j) move_cursor 1 ;;
    k) move_cursor -1 ;;
    ' ') toggle_current ;;
    $'\t') switch_tab 1 ;;
    a) bulk_section enable ;;
    n) bulk_section disable ;;
    $'\e')
      IFS= read -r -s -n 2 -t 1 rest || rest=
      case "$rest" in
        '[B'|'OB') move_cursor 1 ;;
        '[A'|'OA') move_cursor -1 ;;
        '[C'|'OC') fold_current open ;;
        '[D'|'OD') fold_current close ;;
        '[Z') switch_tab -1 ;;
      esac
      ;;
  esac
  return 0
}

# One keystroke per frame, with no debounce and nothing discarded. A full
# read-handle-draw cycle costs ~1-2ms, well under the ~30ms of the fastest macOS
# key repeat, so held keys scroll smoothly without needing to be coalesced.
# (Coalescing is not even possible here: `read -n` makes bash force VMIN=1, so
# an `stty min 0` non-blocking read never returns early.)
run_loop() {
  local key
  while :; do
    draw
    if ! IFS= read -r -s -n 1 key; then
      # bash 3.2 reports both EOF and an interrupted read as 1, so a pending
      # resize is the only way to tell a signal apart from a closed terminal.
      if [[ "$resize_pending" -eq 1 ]]; then
        resize_pending=0
        continue
      fi
      break
    fi
    handle_key "$key" || break
  done
}

main() {
  init_paths
  refresh_state
  setup_terminal
  run_loop
}

if [[ "${SYNC_SKILLS_TEST_MODE:-}" != 1 ]]; then
  main "$@"
  cleanup_terminal
fi
